# Replace every placeholder before starting the services. Do not commit .env.
AI_DFIR_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
AI_DFIR_ADMIN_USERNAME=admin
AI_DFIR_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
AI_DFIR_COOKIE_SECURE=0

# MinIO credentials for the local Compose object store.
AI_DFIR_S3_ACCESS_KEY=replace-with-a-unique-access-key
AI_DFIR_S3_SECRET_KEY=replace-with-a-long-random-object-store-password
AI_DFIR_S3_BUCKET=ai-dfir-evidence
AI_DFIR_S3_REGION=us-east-1
# Leave unset for the bundled MinIO service; set a private HTTPS endpoint for external storage.
AI_DFIR_S3_ENDPOINT=
AI_DFIR_BACKUP_SIGNING_KEY=replace-with-a-random-signing-secret-at-least-32-characters
# Generate a random 32-byte AES key and base64-encode it. Store it separately from backups.
AI_DFIR_S3_SSE_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES

# Password recovery is disabled until SMTP is configured.
AI_DFIR_SMTP_HOST=
AI_DFIR_SMTP_PORT=587
AI_DFIR_SMTP_FROM=
AI_DFIR_SMTP_USERNAME=
AI_DFIR_SMTP_PASSWORD=
AI_DFIR_SMTP_STARTTLS=1
AI_DFIR_SMTP_SSL=0

# Optional integrations.
OPENAI_API_KEY=
VIRUSTOTAL_API_KEY=
